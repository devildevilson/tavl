file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/cli_check.tsv" cases)
set(case_count 0)
foreach(line IN LISTS cases)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${line}")
  list(LENGTH fields count)
  if(NOT count EQUAL 4)
    message(FATAL_ERROR "bad CLI corpus row: ${line}")
  endif()
  list(GET fields 0 name)
  list(GET fields 1 source)
  list(GET fields 2 expected_status)
  list(GET fields 3 expected_diagnostic)
  string(REPLACE "\\n" "\n" source "${source}")
  set(input "${WORK_DIR}/tavl_conformance_${name}.tavl")
  file(WRITE "${input}" "${source}")
  execute_process(COMMAND "${CLI}" check "${input}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL expected_status)
    message(FATAL_ERROR "${name}: exit ${status}, expected ${expected_status}; ${diagnostic}")
  endif()
  if(expected_diagnostic STREQUAL "-")
    if(NOT diagnostic STREQUAL "")
      message(FATAL_ERROR "${name}: unexpected diagnostic: ${diagnostic}")
    endif()
  elseif(NOT diagnostic MATCHES "${expected_diagnostic}")
    message(FATAL_ERROR "${name}: missing diagnostic ${expected_diagnostic}: ${diagnostic}")
  endif()
  math(EXPR case_count "${case_count} + 1")
endforeach()
if(case_count LESS 20)
  message(FATAL_ERROR "CLI conformance corpus unexpectedly small: ${case_count} cases")
endif()
